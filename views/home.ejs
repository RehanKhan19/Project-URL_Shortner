<!DOCTYPE html>
<html lang="en">

<head>
    <style>
        body {
            font-family: 'Times New Roman', Times, serif;
        }
        h1 {
            text-align: center;
        }
    </style>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>URL Shortner</title>
</head>

<body>
    <h1>URL Shortner</h1>
    <% if (locals.id) { %> <%# locals: data sent by backend, here: if backend has sent "id"%>
        <p>Url Generated: http://localhost:8001/url/<%= id %></p>
    <% } %>
    
    <div>
        <h3>Generate URL</h3>
        <form method="POST" action="/url">
            <label>Enter your URL: </label>
            <input 
                type="text" 
                placeholder="https://example.com" 
                name="url" 
            />
            <button type="submit">Generate</button>
        </form>
    </div>
    <div>
        <h3>Generated URLs</h3>
        <% if (locals.urls) { %>
         <table>
            <thead>
                <th>S No.</th>
                <th>Short URL</th>
                <th>Original URL</th>
                <th>Clicks</th>
            </thead>
            <tbody>
                    <% urls.forEach((url, index) => { %>
                    <tr>
                     <td><%= index + 1 %></td>
                     <td>http://localhost:8001/url/<%= url.shortId %></td>
                     <td><%= url.redirectUrl %></td>
                     <td><%= url.visitHistory.length %></td>
                    </tr>
                    <% }) %>
            </tbody>
        </table>
        <% } %>
    </div>

</body>

</html>